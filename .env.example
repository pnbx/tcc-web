# ── TCC Minecraft web platform — environment template ──
# Copy to .env and fill in. NEVER commit the real .env.

# Database — Supabase Postgres. SUPABASE_DB_URL is the connection string from
# the Supabase dashboard (Connect → Connection string; session pooler URI with
# your DB password). Prisma uses directUrl=SUPABASE_DB_URL for migrations and
# the pg adapter for runtime. Keys below are the HTTP API keys (unused while
# auth stays Argon2id+sessions — see README "Security model").
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SECRET_KEY="sb_secret_..."
SUPABASE_JWKS_URL="https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json"
SUPABASE_DB_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Session / crypto secrets — generate with: openssl rand -base64 48
SESSION_SECRET="change-me"
JWT_SECRET="change-me"

# Public Minecraft server address (used for SLP status queries)
MINECRAFT_SERVER_HOST="tccmc.ir"
MINECRAFT_SERVER_PORT="25565"

# RCON — optional. Prefer the TCC bridge plugin (below). If enabled, keep RCON
# firewalled to localhost/VPN only and NEVER expose it publicly.
RCON_HOST="127.0.0.1"
RCON_PORT="25575"
RCON_PASSWORD=""

# TCC bridge plugin — HTTP endpoint the Minecraft plugin exposes on the
# server machine (localhost from the website's perspective). The shared token
# must match MC_TCC_BRIDGE_TOKEN in the plugin config.
BRIDGE_URL=""
BRIDGE_TOKEN=""

# Owner / developer bootstrap.
# The website refuses to boot until the initial owner + developer credential
# has been configured through /setup (values below are only defaults for seeding).
OWNER_USERNAME=""
DEVELOPER_INITIAL_PASSWORD="" # required on first run if empty → /setup flow

# Pterodactyl panel adapter — client API key (ptlc_…), panel base URL and the
# server identifier from the panel URL. Grants command dispatch (auto-rank
# after purchase), power controls, metrics, file manager and console (from
# logs/latest.log). Priority: bridge → pterodactyl → rcon → status-only.
PTERO_PANEL_URL=""
PTERO_API_KEY=""
PTERO_SERVER_ID=""

# Sandbox root for the developer file manager. Must point at the server
# directory only, e.g. /TCC_SERVER or C:/TCC_SERVER
SERVER_FILES_ROOT=""

# Payment provider — Zibal is implemented (src/lib/payments.ts).
# PAYMENT_PROVIDER_MERCHANT_ID is the merchant from the Zibal panel of the
# domain the gateway was registered under; the hosted payment page shows that
# domain. Set it to "zibal" to use the sandbox gateway.
PAYMENT_PROVIDER="zibal"
PAYMENT_PROVIDER_MERCHANT_ID=""
PAYMENT_PROVIDER_CALLBACK_BASE="https://site.tccmc.ir"
